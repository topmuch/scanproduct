# =============================================================================
# VerifScan — Environment variables (example)
# Copy this file to `.env` for local dev, or set each var in the Coolify
# "Environment Variables" panel for production.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite is a local file. The path is relative to the app WORKDIR (/app).
# In production, mount a Coolify persistent volume at /app/db so the file
# survives container rebuilds (see COOLIFY.md, Étape 5).
DATABASE_URL="file:./db/custom.db"

# --- NextAuth (authentication) ---------------------------------------------
# Generate with:  openssl rand -base64 32
# In Coolify you can also click "Generate" next to the variable to create one.
NEXTAUTH_SECRET=""

# Public URL of the deployed app. Change this to your Coolify domain, e.g.
#   NEXTAUTH_URL="https://scanproduct.coolify.yourdomain.com"
NEXTAUTH_URL="http://localhost:3000"

# --- QR code scan URL -------------------------------------------------------
# The absolute origin encoded into QR codes printed on product packaging.
# When a consumer scans a QR code with their phone, this is where they land.
#
# - In dev: defaults to window.location.origin (http://localhost:3000)
# - In prod: MUST be set to your public domain so printed QR codes resolve
#   to the deployed app, not localhost.
#
# Example: NEXT_PUBLIC_SCAN_URL="https://scanproduct.coolify.yourdomain.com"
NEXT_PUBLIC_SCAN_URL="https://verifscan.sn"

# --- SuperAdmin credentials (used by the seed script on first deploy) ------
ADMIN_EMAIL="admin@verifscan.sn"
ADMIN_PASSWORD="ChangeMeOnFirstLogin!2025"

# --- Runtime ----------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME=0.0.0.0

# --- Optional integrations (uncomment & fill if needed) --------------------

# z-ai-web-dev-sdk API key — powers AI skills (image gen, OCR, chat, …)
# ZAI_API_KEY=""

# Cloudinary URL (file uploads) — format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=""

# GitHub token (only needed if the app calls the GitHub API)
# GITHUB_TOKEN=""
