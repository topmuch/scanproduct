// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// VerifScan — Authentication & user management
// ============================================================================
// Roles (stored as String because SQLite does not support Prisma enums):
//   - "SUPERADMIN"  → platform operator, accesses /superadmin
//   - "FABRICANT"   → manufacturer client, accesses /dashboard
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  // Hashed password (bcrypt). NULL only for future OAuth-only accounts.
  password     String?
  // "SUPERADMIN" | "FABRICANT"
  role         String    @default("FABRICANT")
  // Fabricant profile fields
  companyName  String?
  phone        String?
  whatsapp     String?
  website      String?
  description  String?
  address      String?
  city         String?
  country      String?
  avatarUrl    String?
  logoUrl      String?
  // Business info
  taxId        String?
  sector       String?
  yearFounded  Int?
  // Social media
  facebook     String?
  instagram    String?
  linkedin     String?
  // Branding
  brandColor   String    @default("#2563EB")
  // Custom QR badge template (design importé par le fabricant — sert de
  // fond aux badges QR : le QR est composé au centre). NULL = design
  // officiel (template plateforme si défini, sinon badge jaune par défaut).
  badgeTemplateUrl String?
  // Account lifecycle
  status       String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "PENDING"
  emailVerified DateTime?
  lastLoginAt  DateTime?
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  // Gamification
  points       Int       @default(0)
  badges       String?   // JSON-encoded array of badge ids
  // Stats
  transparencyScore Int  @default(0)
  totalScans   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products        Product[]
  lots            Lot[]
  qrCodes         QRCode[]
  scans           Scan[]
  reviewsAuthored Review[]      @relation("ReviewAuthor")
  reviewsReceived Review[]      @relation("ReviewFabricant")
  certifications  Certification[]
  auditLogs       AuditLog[]
  ticketsAuthored Ticket[]      @relation("TicketAuthor")
  notifications   Notification[]
  notificationPreference NotificationPreference?
  emailLogs       EmailLog[]    @relation("EmailLogUser")
  aiConversations AiConversation[]
  inquiriesReceived MarketplaceInquiry[]
  subscriptions   Subscription[]

  @@index([role])
  @@index([status])
}

// Audit log (used by SuperAdmin panel — Logs/Audit page)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. "LOGIN", "CREATE_PRODUCT", "DELETE_LOT"
  entity    String?  // e.g. "User", "Product", "Lot"
  entityId  String?
  ip        String?
  userAgent String?
  metadata  String?  // JSON-encoded
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================================
// Categories
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  emoji       String?
  description String?
  // JSON-encoded FieldConfig[] — fields specific to this category
  schema      String?
  // JSON-encoded FieldConfig[] — fields specific to export (only for export products)
  exportSchema String?
  // Deployment phase: 1 (immediate), 2 (3-6 months), 3 (6-12 months)
  phase       Int      @default(1)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@index([phase])
}

// ============================================================================
// Products
// ============================================================================

model Product {
  id              String   @id @default(cuid())
  name            String
  brand           String?
  description     String?
  category        String?  // legacy free-text category (kept for backward compat)
  categoryId      String?
  categoryRef     Category? @relation(fields: [categoryId], references: [id])
  imageUrl        String?
  weight          String?
  fabricantId     String
  fabricant       User     @relation(fields: [fabricantId], references: [id])
  // Open Food Facts integration — EAN-13 / UPC code-barres. Unique so two fabricants can't claim the
  // same barcode. Nullable because many artisanal products have none.
  barcode         String?  @unique
  // Raw Open Food Facts payload (JSON-encoded string — SQLite has no Json
  // type). Populated when the fabricant scans/looks up a barcode. Kept in
  // sync via offLastSync so we can refresh periodically.
  offData         String?
  offLastSync     DateTime?
  // ── Auto-complétion intelligente (produits types) ────────────────
  // Identifiant du template choisi dans lib/product-templates.ts.
  templateId        String?
  // Durée de conservation du template (mois) — permet l'auto-calcul de la
  // date de péremption des lots sans recharger la librairie côté client.
  shelfLifeMonths   Int?
  // Conseils d'utilisation (JSON-encoded array de strings — SQLite n'a pas
  // de type Json). Rempli depuis le template, modifiable par le fabricant.
  usageTips         String?
  // Précautions d'emploi (JSON-encoded array de strings)
  precautions       String?
  // Conditions de conservation (texte libre, adapté au climat)
  storageConditions String?
  // Category-specific dynamic data (JSON-encoded object keyed by field name)
  categoryData    String?
  // Export-specific data (JSON-encoded object — only populated when isExport=true)
  exportData      String?
  // Whether the product is intended for export (requires extra compliance docs)
  isExport        Boolean  @default(false)
  // Certifications array (JSON-encoded: [{name, issuer, validUntil, fileUrl}])
  certifications  String?
  // Visibility
  isPublic        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  status          String   @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  // Stats
  totalScans      Int      @default(0)
  averageRating   Float    @default(0)
  totalReviews    Int      @default(0)
  // Transparency
  transparencyScore Int    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lots            Lot[]
  reviews         Review[]
  inquiries       MarketplaceInquiry[]

  @@index([fabricantId])
  @@index([category])
  @@index([categoryId])
  @@index([isExport])
  @@index([isPublic])
  @@index([transparencyScore])
  @@index([barcode])
}

// ============================================================================
// Lots (batches)
// ============================================================================

model Lot {
  id                    String   @id @default(cuid())
  reference             String   @unique
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  fabricantId           String
  fabricant             User     @relation(fields: [fabricantId], references: [id])

  // Batch info
  quantity              Int
  lotNumber             String?
  manufactureDate       DateTime?
  expiryDate            DateTime?
  ingredients           String?  // text or JSON
  weight                String?

  // Traceability
  manufacturingLocation String?
  transformationLocation String?
  salesCountries        String?  // JSON-encoded string array

  // Allergens & Nutrition (JSON-encoded)
  allergens             String?  // JSON array
  nutritionalInfo       String?  // JSON object
  warnings              String?  // JSON array

  // Status: "ACTIVE" | "RECALLED" | "EXPIRED" | "DRAFT"
  status                String   @default("ACTIVE")
  recallReason          String?
  recalledAt            DateTime?

  // Blockchain
  blockchainHash        String?

  // Verification
  isVerified            Boolean  @default(false)
  verifiedAt            DateTime?

  // Transparency
  transparencyScore     Int      @default(0)
  transparencyDetails   String?  // JSON-encoded

  // QR + Stats
  qrCodeCount           Int      @default(0)
  totalScans            Int      @default(0)
  lastScannedAt         DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  qrCodes               QRCode[]
  scans                 Scan[]
  historyEvents         LotHistory[]
  certifications        LotCertification[]
  reviews               Review[]

  @@index([fabricantId])
  @@index([productId])
  @@index([status])
  @@index([expiryDate])
  @@index([transparencyScore])
}

// ============================================================================
// Lot History (timeline events)
// ============================================================================

model LotHistory {
  id          String   @id @default(cuid())
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  // type: "fabrication" | "controle" | "marche" | "actif" | "rappelle" | "expire"
  type        String
  title       String
  description String?
  location    String?
  date        DateTime
  time        String?
  metadata    String?  // JSON-encoded

  createdAt   DateTime @default(now())

  @@index([lotId])
  @@index([date])
}

// ============================================================================
// QR Codes
// ============================================================================

model QRCode {
  id            String   @id @default(cuid())
  code          String   @unique
  lotId         String
  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  fabricantId   String?
  fabricant     User?    @relation(fields: [fabricantId], references: [id])

  imageUrl      String?
  size          Int      @default(300)
  color         String   @default("#000000")
  logoUrl       String?

  includeLotNumber    Boolean @default(true)
  includeProductName  Boolean @default(true)
  includeLogo         Boolean @default(false)

  /// Design du rendu PNG : "badge" = cercle jaune LABEL VERIFSCAN avec QR
  /// noir au centre (modèle client), "classic" = QR brut (couleur marque).
  design        String   @default("badge")

  status        String   @default("ACTIVE") // "ACTIVE" | "USED" | "INVALID"
  isDownloaded  Boolean  @default(false)
  downloadedAt  DateTime?

  scans         Int      @default(0)
  lastScanAt    DateTime?
  createdAt     DateTime @default(now())

  scanRecords   Scan[]

  @@index([lotId])
  @@index([fabricantId])
  @@index([status])
}

// ============================================================================
// Scans (analytics)
// ============================================================================

model Scan {
  id            String   @id @default(cuid())
  qrCodeId      String?
  qrCode        QRCode?  @relation(fields: [qrCodeId], references: [id])
  lotId         String
  lot           Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  consumerId    String?
  consumer      Consumer? @relation(fields: [consumerId], references: [id])

  scannedAt     DateTime @default(now())

  // Location
  country       String?
  city          String?
  region        String?
  latitude      Float?
  longitude     Float?

  // Device
  deviceType    String?  // "mobile" | "desktop" | "tablet"
  os            String?
  browser       String?
  userAgent     String?
  ipAddress     String?

  metadata      String?  // JSON-encoded

  @@index([lotId])
  @@index([scannedAt])
  @@index([country])
  @@index([userId])
  @@index([consumerId])
}

// ============================================================================
// Certifications
// ============================================================================

model Certification {
  id              String   @id @default(cuid())
  fabricantId     String
  fabricant       User     @relation(fields: [fabricantId], references: [id], onDelete: Cascade)

  name            String   // "Bio", "ISO 22000", "Halal", etc.
  issuer          String?  // "Ecocert", "Bureau Veritas"...
  certificateNumber String?
  issueDate       DateTime?
  expirationDate  DateTime?
  documentUrl     String?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fabricantId])
}

model LotCertification {
  id          String   @id @default(cuid())
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  name        String
  issuer      String?
  documentUrl String?

  createdAt   DateTime @default(now())

  @@index([lotId])
}

// ============================================================================
// Reviews
// ============================================================================

model Review {
  id             String   @id @default(cuid())
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  lotId          String?
  lot            Lot?     @relation(fields: [lotId], references: [id])
  fabricantId    String?
  fabricant      User?    @relation("ReviewFabricant", fields: [fabricantId], references: [id])
  userId         String?
  user           User?    @relation("ReviewAuthor", fields: [userId], references: [id])

  authorName     String?
  rating         Int      // 1-5
  comment        String?
  isApproved     Boolean  @default(false)
  isVerified     Boolean  @default(false)
  ipAddress      String?
  userAgent      String?

  createdAt      DateTime @default(now())
  approvedAt     DateTime?

  @@index([productId])
  @@index([lotId])
  @@index([fabricantId])
  @@index([isApproved])
}

// ============================================================================
// Support tickets — used by the SuperAdmin Support page (real CRUD-backed
// support system, replacing the previous mock TICKETS array).
// ============================================================================

model Ticket {
  id         String   @id @default(cuid())
  reference  String   @unique // human-readable, e.g. "TKT-2026-0145"

  subject    String
  description String?

  // "Ouvert" | "En cours" | "En attente" | "Résolu" | "Fermé"
  status     String   @default("Ouvert")
  // "Basse" | "Normale" | "Haute" | "Urgente"
  priority   String   @default("Normale")
  // "Technique" | "Facturation" | "Compte" | "Autre"
  category   String   @default("Technique")

  // Requester (fabricant user). Nullable so admins can create internal tickets
  // not tied to a specific user account.
  userId     String?
  user       User?    @relation("TicketAuthor", fields: [userId], references: [id])

  // Requester display fields (denormalized so we can render even if user is null)
  requesterName    String?
  requesterCompany String?

  // Assignment
  assignedTo String? // admin display name

  // JSON-encoded arrays/objects (SQLite limitation):
  //   tags        → string[]
  //   messages    → { from: "client"|"admin", author: string, content: string, timestamp: string }[]
  //   internalNotes → { date: string, author: string, content: string }[]
  tags           String?
  messages       String?
  internalNotes  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// Site-wide settings (key/value store for superadmin-configurable options)
// ============================================================================
// Used for dynamic site config like favicon URL, site name, etc.
// Stored as String values (JSON-encode complex values if needed).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Notifications — in-app notification center for fabricants & superadmins
// ============================================================================
// Types:
//   - "lot_recall"      → a lot was recalled (critical)
//   - "quota_warning"   → fabricant reached 80% of plan QR quota
//   - "quota_exceeded"  → fabricant reached 100% of plan QR quota
//   - "new_scan"        → first scan on a lot (or milestone)
//   - "weekly_report"   → weekly stats digest
//   - "system"          → generic platform message
//   - "ticket_update"   → support ticket status changed
//   - "subscription"    → plan changes, payment success/failure
//
// Channels (JSON-encoded array of strings): ["in_app", "email", "sms"]
// Only "in_app" is always on; "email" depends on user preferences + SMTP config.
//
// `data` is a JSON-encoded object with contextual payload (lotId, planName…).
model Notification {
  id         String    @id @default(cuid())
  userId     String    // recipient (fabricant or superadmin)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String    // see comment above
  title      String
  message    String
  data       String?   // JSON-encoded contextual payload

  // Delivery
  channels   String    @default("[\"in_app\"]") // JSON array of channels used
  readAt     DateTime? // null = unread
  emailedAt  DateTime? // null = not emailed (or email skipped)
  emailedTo  String?   // recipient email snapshot

  // Severity for UI styling: "info" | "success" | "warning" | "critical"
  severity   String    @default("info")

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// Notification preferences — per-user opt-in/opt-out for each channel & type
// ============================================================================
// Stored as a single row per user. The `prefs` JSON object has the shape:
//   {
//     "lot_recall":      { "in_app": true, "email": true,  "sms": false },
//     "quota_warning":   { "in_app": true, "email": true,  "sms": false },
//     "new_scan":        { "in_app": true, "email": false, "sms": false },
//     "weekly_report":   { "in_app": true, "email": true,  "sms": false },
//     ...
//   }
// Missing keys default to in_app=true, others=false.
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled    Boolean  @default(true)   // global email opt-in
  smsEnabled      Boolean  @default(false)  // global SMS opt-in (not yet wired)
  pushEnabled     Boolean  @default(true)   // in-app opt-in

  prefs           String   @default("{}")   // JSON-encoded per-type prefs

  updatedAt       DateTime @updatedAt
}

// ============================================================================
// Email log — tracks every outbound email (success or failure)
// ============================================================================
// Used by superadmin for debugging email delivery + audit trail.
// Status: "queued" | "sent" | "failed" | "skipped"
//   - "queued"  → created just before send attempt
//   - "sent"    → SMTP accepted the message
//   - "failed"  → SMTP rejected (error field contains the message)
//   - "skipped" → no SMTP configured (dev mode) — body logged to console
model EmailLog {
  id         String   @id @default(cuid())
  to         String
  from       String?
  subject    String
  body       String?  // plain text or HTML (truncated if too long)
  status     String   @default("queued")
  error      String?
  userId     String?  // optional link to user (nullable for system emails)
  user       User?    @relation("EmailLogUser", fields: [userId], references: [id])

  sentAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([to])
}

// ============================================================================
// AI Conversations — V3 AI Intelligence module
// ============================================================================
// Persists chat history between fabricants and the VerifScan AI assistant.
// Each conversation has a title (auto-generated from first message) and a
// list of messages with role "user" | "assistant".
//
// `context` is a JSON-encoded object with optional payload like:
//   { productId, lotId, tool: "description"|"translate"|"analyze" }
// so the assistant can ground its answers in the fabricant's real data.
model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @default("Nouvelle conversation")
  // "chat" | "description" | "translate" | "analyze" | "recommendations"
  tool      String   @default("chat")
  context   String?  // JSON-encoded contextual payload

  messages  AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // "user" | "assistant"
  role           String
  content        String

  // Optional metadata (JSON): tokens used, model, tool call info, etc.
  metadata       String?

  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ============================================================================
// V3 Module 2 — Marketplace B2B (demandes de devis distributeurs)
// ============================================================================
// Les distributeurs parcourent le catalogue public VerifScan et envoient des
// demandes de devis aux fabricants. Chaque demande est liée à un produit et
// un fabricant. Le fabricant répond depuis son dashboard.
//
// Status: "pending" | "responded" | "accepted" | "declined"
model MarketplaceInquiry {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  fabricantId     String
  fabricant       User     @relation(fields: [fabricantId], references: [id], onDelete: Cascade)

  // Requester info (no account required — B2B lead capture)
  requesterName       String
  requesterCompany    String?
  requesterEmail      String
  requesterPhone      String?
  requesterCountry    String?
  requesterCity       String?

  // Inquiry details
  message         String
  quantity        Int?
  targetPrice     String?  // free text: "500 FCFA/unité"
  deliveryDelay   String?  // requested delivery timeframe

  // Status + response
  status          String   @default("pending")
  response        String?
  respondedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fabricantId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// V3 Module 5 — Programme de Fidélité Consommateur
// ============================================================================
// Les consommateurs qui scannent des produits VerifScan accumulent des points.
// Identifiés par cookie (anonymousId) jusqu'à inscription (email/phone).
//
// Badge tiers: "explorateur" (100 pts) | "ambassadeur" (500 pts) | "expert" (1000 pts)
model Consumer {
  id            String   @id @default(cuid())
  anonymousId   String   @unique  // cookie-based ID (set on first scan)
  email         String?
  phone         String?
  name          String?

  points        Int      @default(0)
  totalScans    Int      @default(0)
  badges        String?  // JSON array of badge ids
  favoriteFabricantIds String? // JSON array

  scans         Scan[]
  redemptions   LoyaltyRedemption[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([anonymousId])
  @@index([email])
}

// Reward redemption — consumer spends points on a reward
// Status: "pending" | "fulfilled" | "cancelled"
model LoyaltyRedemption {
  id          String   @id @default(cuid())
  consumerId  String
  consumer    Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  fabricantId String?  // who provides the reward (optional for platform rewards)
  productId   String?  // optional product link

  rewardType  String   // "discount_5" | "discount_10" | "free_product" | "factory_visit"
  rewardLabel String   // human-readable: "Réduction 5%"
  pointsCost  Int      // points spent
  code        String?  // redemption code generated
  status      String   @default("pending")

  createdAt   DateTime @default(now())
  fulfilledAt DateTime?

  @@index([consumerId])
  @@index([fabricantId])
  @@index([status])
}

// ============================================================================
// V3 — Abonnements fabricants (cycle de vie plan Starter / Pro / Business)
// ============================================================================
// One row per subscription period. The ACTIVE row drives:
//   - plan-limits.getUserPlan() (quotas QR / produits)
//   - getFabricantAbonnement()  (dates réelles dans la page Abonnement)
//   - /api/cron/subscription-alerts (emails de fin d'abonnement)
//
// Status: "ACTIVE"    → current period, quotas enforced
//         "EXPIRED"   → past expiresAt, flipped automatically by the cron job
//         "CANCELLED" → manually terminated (admin)
//
// Auto-provisioning: legacy users without any Subscription row get one created
// lazily (rolling 30-day period from the current plan setting) by
// ensureSubscription() — so the alerts job never misses a fabricant.
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan      String   @default("starter") // "starter" | "pro" | "business"
  status    String   @default("ACTIVE")  // "ACTIVE" | "EXPIRED" | "CANCELLED"

  startedAt DateTime @default(now())
  expiresAt DateTime // end of the paid period (billing/renewal date)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================================
// BLOG — articles rédactionnels gérés par le SuperAdmin, publiés sur /blog
// ============================================================================
// Contenu en Markdown (rendu côté client avec react-markdown). Le référeneement
// Google est assuré par : generateMetadata par article (title/description/canonical/
// openGraph), JSON-LD "Article" sur /blog/[slug], et l'ajout dynamique des URLs
// des articles publiés dans sitemap.ts.
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique // URL : /blog/<slug>
  title       String
  excerpt     String   // résumé (cards + meta description fallback)
  content     String   // Markdown complet
  coverImage  String?  // chemin public optionnel (ex: /images/blog/xxx.webp)
  category    String   @default("Traçabilité") // badge de rubrique
  readTime    Int      @default(5) // minutes de lecture estimées
  author      String   @default("Équipe VerifScan")
  published   Boolean  @default(false)
  publishedAt DateTime? // fixé à la première publication (stabilité SEO)
  seoTitle    String?  // <title> Google si défini, sinon title
  seoDescription String? // meta description si définie, sinon excerpt
  seoKeywords String?  // chaîne "mot1, mot2, ..." (meta keywords + JSON-LD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}

// ============================================================================
// SYSTÈME ARTISANAL — QR codes pré-imprimés vendus en packs aux artisans
// ============================================================================
// Parcours hybride (coexiste avec le système formel Product/Lot/QRCode) :
//   1. Le SuperAdmin génère un Batch (ex. 1000 QR) découpé en Packs (ex. 5×200)
//   2. Chaque pack contient N PreActivatedLot inactifs + 1 QR Code Maître
//   3. Le PDF d'impression (/api/admin/print-batch) met le Maître en rouge
//   4. L'artisan achète un pack (70 000 FCFA), scanne le Maître, remplit un
//      formulaire unique → TOUTES les étiquettes du pack s'activent d'un coup
//   5. Le client final scanne un QR produit → /a/<code> → page Artisan
//      chaleureuse (ambre/stone) avec contact WhatsApp direct
// ============================================================================
// VerifScan - Compte ARTISAN (parcours informel)
// ============================================================================
// L'artisan informel n'a ni email ni entreprise : son NUMERO de telephone est
// son identifiant. Compte cree automatiquement :
//   - a la VENTE d'un pack par le SuperAdmin (POST /api/admin/sell-pack),
//     avec le mot de passe par defaut « 0000 » envoye par WhatsApp ;
//   - ou a la PREMIERE connexion sur /artisan/login (POST /api/artisan/login).
// Le mot de passe est stocke HASHE (bcryptjs) - jamais renvoye par l'API.
// ============================================================================
model Artisan {
  id        String   @id @default(cuid())
  phone     String   @unique // identifiant de connexion (ex. "771234567")
  password  String   @default("0000") // hash bcrypt du mot de passe
  name      String?  // nom de l'artisan / de la marque

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packs     Pack[]

  @@index([phone])
}

model Batch {
  id            String    @id @default(cuid())
  totalQuantity Int       // 1000
  packSize      Int       // 200
  numberOfPacks Int       // 5

  printedAt     DateTime?
  status        String    @default("pending") // pending, printed, distributed

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  packs         Pack[]

  @@index([status])
}

model Pack {
  id           String   @id @default(cuid())
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  packNumber   Int      // 1, 2, 3, 4, 5
  quantity     Int      // 200
  price        Int      // 70000 (FCFA)

  // QR Code Maître
  masterQrCode String   @unique

  // Info artisan (quand vendu)
  soldTo       String?
  soldAt       DateTime?
  artisanPhone String?
  artisanEmail String?

  // Compte Artisan lie au pack (cree a la vente par le SuperAdmin ou a
  // l'activation). Nullable : les packs en stock ne sont lies a personne.
  artisanId    String?
  artisan      Artisan? @relation(fields: [artisanId], references: [id])

  // Réseaux sociaux de l'artisan (optionnels, remplis à l'activation)
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?

  // Galerie « L'atelier en images » — tableau JSON d'URLs (max 3)
  artisanPhotos String?

  // Prix consommateur affiché sur la page produit (texte libre, ex. « 5 000 FCFA »)
  // ⚠️ Distinct de `price` = prix B2B du pack de QR.
  productPrice String?

  // Désignation du produit : description courte affichée sous le nom
  // sur la page publique (texte libre, ex. « Beurre de karité brut
  // 100 % naturel, non raffiné, préparé à la main »).
  productDesignation String?

  status       String   @default("available") // available, sold, activated

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lots         PreActivatedLot[]

  @@index([batchId])
  @@index([status])
  @@index([masterQrCode])
  @@index([artisanId])
}

model PreActivatedLot {
  id                String    @id @default(cuid())
  packId            String
  pack              Pack      @relation(fields: [packId], references: [id], onDelete: Cascade)

  qrCode            String    @unique
  isMaster          Boolean   @default(false)

  status            String    @default("inactive") // inactive, active
  activatedAt       DateTime?

  // Infos produit (remplies à l'activation du pack)
  productName       String?
  contenance        String?
  ingredients       String?
  manufacturingDate DateTime?
  expirationDate    DateTime?
  artisanName       String?
  contactPhone      String?
  photoUrl          String?

  // Prix consommateur + désignation PAR PRODUIT (activation flexible :
  // un pack peut contenir plusieurs produits différents — chaque lot porte
  // les siens ; fallback sur Pack.productPrice/productDesignation pour les
  // packs mono-produit historiques).
  productPrice       String?
  productDesignation String?

  // Page publique engageante : histoire de l'artisan + conseils d'utilisation
  artisanBio        String? // texte libre (section "L'histoire de l'artisan")
  usageTips         String? // un conseil par ligne (section "Conseils d'utilisation")

  // ── Auto-complétion intelligente (produits types) ────────────────
  // Identifiant du template choisi à l'activation (lib/product-templates.ts)
  templateId        String?
  // Précautions d'emploi (JSON-encoded array de strings — SQLite sans Json)
  precautions       String?
  // Conditions de conservation (texte libre, adapté au climat)
  storageConditions String?

  // Alerte contrefaon : JSON {detectedAt, regionA, tzA, regionB, tzB} -
  // rempli quand le meme QR est scanne depuis 2 regions distinctes en < 48 h
  counterfeitAlert  String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scans             ArtisanScan[]
  reviews           ArtisanReview[]

  @@index([packId])
  @@index([qrCode])
  @@index([status])
  @@index([isMaster])
}

model ArtisanScan {
  id         String          @id @default(cuid())
  lotId      String
  lot        PreActivatedLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  scannedAt  DateTime        @default(now())
  country    String?
  city       String?
  deviceType String?
  // Fuseau horaire IANA du visiteur (ex. "Africa/Dakar") - signal geo
  // gratuit pour la detection de contrefacon (scans multi-regions).
  timezone   String?

  @@index([lotId])
  @@index([scannedAt])
}

// ============================================================================
// VerifScan - Avis clients sur les produits artisanaux (page /a/[code])
// Moderation light : `hidden` permet a un futur back-office de masquer un
// avis sans le supprimer. Ecriture publique (rate limitee), lecture publique.
// ============================================================================
model ArtisanReview {
  id         String          @id @default(cuid())
  lotId      String
  lot        PreActivatedLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  authorName String
  rating     Int             // 1..5
  comment    String
  hidden     Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([lotId])
  @@index([createdAt])
}

// ============================================================================
// Photos du parcours ARTISANAL stockées EN BASE (BLOB) — fix « photo ne
// s'affiche plus après activation ». Avant : fichiers écrits sur le disque
// (UPLOAD_DIR) → PERDUS à chaque redéploiement Coolify si le volume n'est
// pas (ou mal) monté. La DB SQLite vit sur le volume /app/data (monté
// obligatoirement — sinon la DB entière disparaît) → les photos survivent
// aux redéploiements. Compressées WebP à l'upload (sharp, ≤ 1200px) pour
// garder la base légère. Servies par GET /api/artisan/photo/<filename>.
// ============================================================================
model ArtisanPhoto {
  id        String   @id @default(cuid())
  filename  String   @unique // ex. artisan-<uuid>.webp
  mimeType  String // image/webp, image/jpeg… (fallback si sharp échoue)
  size      Int // octets
  data      Bytes // contenu binaire de l'image
  createdAt DateTime @default(now())
}

// ============================================================================
// VerifScan API publique — clés d'accès (Paramètres SuperAdmin → API & Intégrations)
// La clé complète n'est affichée qu'UNE seule fois à la création (pattern
// Stripe) ; la base ne stocke que son SHA-256 (une fuite de la DB ne compromet
// pas les clés) + le préfixe pour l'affichage masqué dans l'UI.
// Usage : Authorization: Bearer sk_live_... ou X-API-Key: sk_live_...
// ============================================================================
model ApiKey {
  id         String    @id @default(cuid())
  name       String // libellé lisible ("Intégration e-commerce", "App partenaire"…)
  prefix     String // ex. "sk_live_ab12cd34" (affichable sans danger)
  keyHash    String    @unique // SHA-256 hex de la clé complète
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  lastUsedIp String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([active])
}

// ============================================================================
// VerifScan API — webhooks sortants (Paramètres SuperAdmin → API & Intégrations)
// À chaque événement (scan vérifié, inscription, signalement, activation de
// plan), chaque webhook actif abonné reçoit un POST JSON signé HMAC-SHA256 :
// en-têtes X-VerifScan-Event + X-VerifScan-Signature: sha256=<hmac hex>.
// `events` = liste CSV (ex. "scan.verified,user.registered") ou "*" (tout).
// ============================================================================
model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String // CSV des événements ou "*"
  secret    String // secret HMAC dédié à CE webhook (affiché une fois, régénérable)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
